generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- TABLAS CATÁLOGO ---

model Departamento {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  empleados   Empleado[]
}

// --- TABLA DE EMPLEADOS (Contexto El Salvador) ---

model Empleado {
  id              Int              @id @default(autoincrement())
  nombres         String
  apellidos       String
  dui             String           @unique // Formato: 00000000-0
  nit             String?          @unique // Opcional, ya que ahora el DUI reemplaza al NIT en muchos casos
  nup_afp         String?          @unique // Número Único Previsional
  fechaIngreso    DateTime         @default(now())
  fechaNacimiento DateTime         @db.Date
  estado          Boolean          @default(true) // Activo o Inactivo
  genero          String?          // Hombre o Mujer
  correo          String?
  telefono        String?
  departamentoId  Int
  departamento    Departamento     @relation(fields: [departamentoId], references: [id])

  planillas DetallePlanilla[]
  contratos Contrato[]
  marcaciones Marcacion[]
}

// --- TABLAS DE PLANILLA (Ajustadas para el controlador) ---

model Planilla {
  id              Int               @id @default(autoincrement())
  mes             String // Cambiado a String para guardar "Mayo", "Junio", etc.
  anio            Int
  tipo            String            @default("Mensual")
  estado          String            @default("Borrador")
  fechaGeneracion DateTime          @default(now())
  @@unique([mes, anio])
  detalles        DetallePlanilla[]
}

model DetallePlanilla {
  id         Int  @id @default(autoincrement())
  planillaId Int
  empleadoId Int? // Opcional por si el empleado se borra en el futuro, el registro queda

  // La "Foto" financiera del mes (Lo que el controlador envía)
  empleadoNombre    String // Guardamos el nombre completo como texto para el historial
  salarioContratado Decimal  @db.Decimal(10, 2)
  isss              Decimal  @db.Decimal(10, 2)
  afp               Decimal  @db.Decimal(10, 2)
  renta             Decimal  @db.Decimal(10, 2)
  contratoId        Int
  contrato          Contrato @relation(fields: [contratoId], references: [id])
  salarioLiquido    Decimal  @db.Decimal(10, 2)
  planilla Planilla  @relation(fields: [planillaId], references: [id])
  empleado Empleado? @relation(fields: [empleadoId], references: [id])
}

// --- TABLA DE USUARIOS (Autenticación - MODIFICADA) ---

model Usuario {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  password       String // Hash bcrypt
  nombreCompleto String
  correo         String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // RELACIÓN CON EL NUEVO MODELO ROL
  // Se define como opcional (Int?) temporalmente por seguridad si ya tienes datos existentes.
  rolId          Int?
  rol            Rol?     @relation(fields: [rolId], references: [id])
}

model Contrato {
  id                Int       @id @default(autoincrement())
  empleadoId        Int
  tipoContrato      String
  cargo             String
  fechaInicio       DateTime  @db.Date
  fechaFin          DateTime? @db.Date
  salarioContratado Decimal   @db.Decimal(10, 2)
  horaEntradaEsperada String    @default("08:00")
  horaSalidaEsperada  String    @default("17:00")
  diasLaborales       String    @default("[\"Lunes\",\"Martes\",\"Miércoles\",\"Jueves\",\"Viernes\"]")
  periodoPrueba     String
  clausulas         String?
  estado            String    @default("Vigente") // Vigente, Finalizado, Suspendido

  detallePlanillas DetallePlanilla[]
  // Relación con Empleado (un empleado puede tener muchos contratos a lo largo del tiempo)
  empleado         Empleado          @relation(fields: [empleadoId], references: [id])
  documentos       ContratoDocumento[]
}

model ContratoDocumento {
  id             Int      @id @default(autoincrement())
  contratoId     Int
  nombreArchivo  String
  nombreOriginal String
  rutaArchivo    String
  tipoMime       String
  tamano         Int
  tipo           String   @default("CONTRATO_FIRMADO")
  fechaSubida    DateTime @default(now())

  contrato       Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
}

model Marcacion {
  id          Int       @id @default(autoincrement())
  empleadoId  Int
  fecha       DateTime  @db.Date
  horaEntrada DateTime
  horaSalida  DateTime?
  estado      String    @default("Presente") // Presente, Ausente, Tardanza
  
  empleado    Empleado  @relation(fields: [empleadoId], references: [id])
}

// --- NUEVAS TABLAS PARA CONTROL DE ACCESOS (RBAC) ---

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique // Ej: "Administrador", "Finanzas"
  descripcion String?
  isDefault   Boolean      @default(false)
  
  // Relaciones
  usuarios    Usuario[]
  permisos    RolPermiso[]
}

model Permiso {
  id     String       @id // Guardará exactamente tus IDs del frontend: 'dashboard', 'planillas', etc.
  nombre String       // Ej: "Dashboard", "Generación de Planillas"
  
  // Relaciones
  roles  RolPermiso[]
}

// Tabla intermedia para la relación Muchos a Muchos entre Roles y Permisos
model RolPermiso {
  rolId     Int
  permisoId String
  
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}